# ==============================================================================
# Environment Variables Example File
# ==============================================================================
# Copy this file to '.env' on your server and fill in your actual values.
#
# LEGEND:
#   - <INSERT_YOURS_INFORMATION>: Mandatory / environment-specific values you must provide.
#   - Pre-filled values: Internal defaults that can remain fixed as-is.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CUSTOM PARAMETERS (FILL IN WITH YOUR ENVIRONMENT DETAILS)
# ------------------------------------------------------------------------------

# --- MQTT BROKER (Home Assistant Mosquitto) ---
# Local IP address or hostname of your server instance hosting Mosquitto
MQTT_HOST=<INSERT_YOURS_INFORMATION>
MQTT_USER=<INSERT_YOURS_INFORMATION>
MQTT_PASSWORD=<INSERT_YOURS_INFORMATION>

# --- TAPO CAMERA (RTSP STREAM) ---
# Credentials and IP to access the camera RTSP stream
CAMERA_IP=<INSERT_YOURS_INFORMATION>
CAMERA_USER=<INSERT_YOURS_INFORMATION>
CAMERA_PASSWORD=<INSERT_YOURS_INFORMATION>

# --- COMPREFACE / DOUBLE-TAKE API KEY ---
# API key generated via CompreFace web dashboard (http://<SERVER_IP>:8000)
# after creating an application and its associated 'Recognition Service'
COMPREFACE_API_KEY=<INSERT_YOURS_INFORMATION>


# ------------------------------------------------------------------------------
# 2. FIXED / INTERNAL DEFAULT PARAMETERS (MODIFICATION OPTIONAL)
# ------------------------------------------------------------------------------

# --- COMPREFACE DATABASE (PostgreSQL) ---
# Credentials for the internal PostgreSQL database storing CompreFace vectors & metadata.
POSTGRES_USER=compreface
POSTGRES_PASSWORD=compreface
POSTGRES_DB=compreface
